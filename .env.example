# Variables a creer dans Vercel (Settings > Environment Variables). Ne rien mettre de reel dans ce fichier.

# Cle API SasPay : sk_test_... pour tester, sk_live_... en production (scope PAYIN suffit)
SASPAY_API_KEY=

# Secret de signature du webhook SasPay (affiche une seule fois a la creation du webhook)
SASPAY_WEBHOOK_SECRET=

# URL publique exacte du site, https://, sans / final
APP_URL=https://smartcaisse-ashen.vercel.app

# Cle "service_role" de Supabase (Settings > API). Secrete : jamais dans le navigateur ni sur GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : plafond mensuel d'encaissement en ligne (FCFA). Defaut 940000 (marge sous le 1 000 000 du compte Particulier)
# SASPAY_PLAFOND_MENSUEL=940000
